/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About RunAppContainer"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,14,14,21,20
    LTEXT           "RunAppContainer, Version 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2019",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "OK",IDOK,113,41,50,14,WS_GROUP
END

IDD_RUNAPPCONTAINER_DIALOG DIALOGEX 0, 0, 473, 243
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CLIPSIBLINGS | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Run Executable in AppContainer"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "App Container Name:",IDC_STATIC,7,15,70,8
    EDITTEXT        IDC_NAME,82,12,160,14,ES_AUTOHSCROLL
    LTEXT           "Executable + Args:",IDC_STATIC,7,40,63,8
    EDITTEXT        IDC_EXEPATH,82,36,325,14,ES_AUTOHSCROLL
    PUSHBUTTON      "&Browse...",IDC_BROWSE,416,36,50,14
    DEFPUSHBUTTON   "Run!",IDC_RUN,7,189,50,40
    LTEXT           "File / directories to allow access:",IDC_STATIC,7,60,104,8
    EDITTEXT        IDC_FILES,7,72,459,45,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "Registry keys to allow access:",IDC_STATIC,7,126,97,8
    EDITTEXT        IDC_REGISTRY,7,137,459,41,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    EDITTEXT        IDC_INFO,69,186,397,50,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | ES_WANTRETURN | WS_VSCROLL
END


